<%- include('partials/header', { pageTitle: 'OneCard', active: 'payments' }) %>

<h1 class="page-title">OneCard &mdash; Tuition &amp; Payments</h1>
<p class="page-subtitle">This is a <strong>simulated</strong> payment section. No real payment gateway is connected.</p>

<% if (justPaid) { %>
  <div class="alert alert-success">Payment Successful &mdash; recorded as a simulation in the database.</div>
<% } %>

<div class="due-box">
  <div>
    <div class="label">Current Due</div>
    <div class="amount"><%= amountDue.toLocaleString() %> BDT</div>
  </div>
  <% if (amountDue > 0) { %>
    <form method="POST" action="/payments/pay">
      <button type="submit" class="btn">Pay Now</button>
    </form>
  <% } else { %>
    <span class="pill pill-good">All dues cleared</span>
  <% } %>
</div>

<div class="card">
  <h2>Payment History <span class="sim-tag">Simulated</span></h2>
  <table>
    <thead>
      <tr><th>Date</th><th>Amount (BDT)</th><th>Method</th><th>Status</th></tr>
    </thead>
    <tbody>
      <% history.forEach(p => { %>
        <tr>
          <td><%= new Date(p.payment_date).toLocaleDateString('en-GB') %></td>
          <td><%= Number(p.amount).toLocaleString() %></td>
          <td><%= p.method %></td>
          <td><span class="pill pill-good"><%= p.status %></span></td>
        </tr>
      <% }) %>
      <% if (history.length === 0) { %>
        <tr><td colspan="4">No payment history yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
