<%- include('partials/header', { pageTitle: 'Results', active: 'results' }) %>

<h1 class="page-title">Results</h1>
<p class="page-subtitle">Grades and GPA by course.</p>

<div class="card">
  <table>
    <thead>
      <tr><th>Course</th><th>Semester</th><th>Grade</th><th>GPA</th></tr>
    </thead>
    <tbody>
      <% rows.forEach(row => { %>
        <tr>
          <td><%= row.code %> &mdash; <%= row.name %></td>
          <td><%= row.semester %></td>
          <td><%= row.grade %></td>
          <td><%= Number(row.gpa).toFixed(2) %></td>
        </tr>
      <% }) %>
      <% if (rows.length === 0) { %>
        <tr><td colspan="4">No results published yet.</td></tr>
      <% } %>
    </tbody>
  </table>

  <% if (rows.length) { %>
    <p style="margin-top:1.25rem;"><strong>Semester GPA (avg):</strong> <%= avgGpa %></p>
  <% } %>
</div>

<%- include('partials/footer') %>
